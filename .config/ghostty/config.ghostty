font-family = Input Mono Narrow

theme = Dark Modern

window-width = 80
window-height = 25
window-padding-x = 4,4
window-padding-y = 4,4
window-padding-color = extend

bell-features = attention, title, border

notify-on-command-finish        = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after  = 45s

# TODO: remove when unlimited scrollback ships
scrollback-limit = 10000000

config-file = platform.ghostty
